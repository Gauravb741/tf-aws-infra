#!/bin/bash
# =============================================================================
# Bootstrap Terraform Remote State
#
# Creates the S3 bucket and DynamoDB table required for remote Terraform state.
#
# Run this ONCE before any other Terraform command.
# These resources must exist before `terraform init` can succeed.
#
# Usage:
#   chmod +x terraform/scripts/bootstrap-state.sh
#   ./terraform/scripts/bootstrap-state.sh
#
# Requirements:
#   - AWS CLI installed and configured (aws configure)
#   - IAM permissions: s3:CreateBucket, s3:PutBucketVersioning,
#     s3:PutBucketEncryption, dynamodb:CreateTable
# =============================================================================
set -euo pipefail

# ------------------------------------------------------------------
# Configuration — change these values to suit your AWS account
# ------------------------------------------------------------------
AWS_REGION="${AWS_REGION:-us-east-1}"
PROJECT_NAME="${PROJECT_NAME:-devops-platform}"
# Bucket names must be globally unique — the account ID suffix helps
AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
STATE_BUCKET="${PROJECT_NAME}-terraform-state-${AWS_ACCOUNT_ID}"
LOCK_TABLE="${PROJECT_NAME}-terraform-locks"

echo "============================================="
echo "  Terraform Remote State Bootstrap"
echo "  Region:       $AWS_REGION"
echo "  State bucket: $STATE_BUCKET"
echo "  Lock table:   $LOCK_TABLE"
echo "============================================="

# ------------------------------------------------------------------
# Create S3 bucket for Terraform state
# ------------------------------------------------------------------
echo ""
echo "[1/5] Creating S3 state bucket..."

if aws s3api head-bucket --bucket "$STATE_BUCKET" 2>/dev/null; then
  echo "  Bucket already exists: $STATE_BUCKET"
else
  if [ "$AWS_REGION" = "us-east-1" ]; then
    # us-east-1 does not support the LocationConstraint parameter
    aws s3api create-bucket \
      --bucket "$STATE_BUCKET" \
      --region "$AWS_REGION"
  else
    aws s3api create-bucket \
      --bucket "$STATE_BUCKET" \
      --region "$AWS_REGION" \
      --create-bucket-configuration LocationConstraint="$AWS_REGION"
  fi
  echo "  Created: $STATE_BUCKET"
fi

# ------------------------------------------------------------------
# Enable versioning — allows recovery of previous state files
# ------------------------------------------------------------------
echo ""
echo "[2/5] Enabling S3 bucket versioning..."
aws s3api put-bucket-versioning \
  --bucket "$STATE_BUCKET" \
  --versioning-configuration Status=Enabled
echo "  Versioning enabled"

# ------------------------------------------------------------------
# Enable server-side encryption — state files contain sensitive data
# ------------------------------------------------------------------
echo ""
echo "[3/5] Enabling S3 bucket encryption..."
aws s3api put-bucket-encryption \
  --bucket "$STATE_BUCKET" \
  --server-side-encryption-configuration '{
    "Rules": [
      {
        "ApplyServerSideEncryptionByDefault": {
          "SSEAlgorithm": "AES256"
        },
        "BucketKeyEnabled": true
      }
    ]
  }'
echo "  Encryption enabled (AES256)"

# ------------------------------------------------------------------
# Block all public access — state files must NEVER be public
# ------------------------------------------------------------------
echo ""
echo "[4/5] Blocking public access to S3 bucket..."
aws s3api put-public-access-block \
  --bucket "$STATE_BUCKET" \
  --public-access-block-configuration \
    BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
echo "  Public access blocked"

# ------------------------------------------------------------------
# Create DynamoDB table for state locking
# Prevents two users from running terraform apply simultaneously,
# which would corrupt the state file.
# ------------------------------------------------------------------
echo ""
echo "[5/5] Creating DynamoDB lock table..."

if aws dynamodb describe-table --table-name "$LOCK_TABLE" --region "$AWS_REGION" 2>/dev/null; then
  echo "  Table already exists: $LOCK_TABLE"
else
  aws dynamodb create-table \
    --table-name "$LOCK_TABLE" \
    --attribute-definitions AttributeName=LockID,AttributeType=S \
    --key-schema AttributeName=LockID,KeyType=HASH \
    --billing-mode PAY_PER_REQUEST \
    --region "$AWS_REGION"
  echo "  Created: $LOCK_TABLE"
fi

# ------------------------------------------------------------------
# Output the values to update in versions.tf
# ------------------------------------------------------------------
echo ""
echo "============================================="
echo "  Bootstrap complete!"
echo ""
echo "  Update the backend block in versions.tf:"
echo ""
echo '  backend "s3" {'
echo "    bucket         = \"$STATE_BUCKET\""
echo '    key            = "dev/terraform.tfstate"  # or prod/'
echo "    region         = \"$AWS_REGION\""
echo '    encrypt        = true'
echo "    dynamodb_table = \"$LOCK_TABLE\""
echo '  }'
echo "============================================="