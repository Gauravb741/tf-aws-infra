# Terraform state files — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terraform plan output — may contain sensitive data
*.tfplan
tfplan

# Terraform variable files with real values
*.tfvars
!*.tfvars.example

# AWS credentials
.aws/
credentials
*.pem
*.key
*.crt

# Environment files
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.venv/
venv/
env/

# Docker
.dockerignore

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/